{
  "Segment": {
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "2",
        "default": "2",
        "title": "Schema Version",
        "type": "string"
      },
      "ym": {
        "pattern": "^2025-(0[7-9]|1[0-2])$",
        "title": "Ym",
        "type": "string"
      },
      "sgg": {
        "pattern": "^\\d{5}$",
        "title": "Sgg",
        "type": "string"
      },
      "dong_cd": {
        "pattern": "^\\d{8}$",
        "title": "Dong Cd",
        "type": "string"
      },
      "dong_nm": {
        "minLength": 1,
        "title": "Dong Nm",
        "type": "string"
      },
      "age_band": {
        "enum": [
          "10s",
          "20s",
          "30s",
          "40s",
          "50s",
          "60plus"
        ],
        "title": "Age Band",
        "type": "string"
      },
      "x": {
        "title": "X",
        "type": "number"
      },
      "y": {
        "title": "Y",
        "type": "number"
      },
      "crs": {
        "minLength": 1,
        "title": "Crs",
        "type": "string"
      },
      "coordinate_source": {
        "minLength": 1,
        "title": "Coordinate Source",
        "type": "string"
      },
      "indicators": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": "Indicators",
        "type": "object"
      },
      "indicator_version": {
        "minLength": 1,
        "title": "Indicator Version",
        "type": "string"
      },
      "residents": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "title": "Residents"
      },
      "blind_flag": {
        "title": "Blind Flag",
        "type": "boolean"
      }
    },
    "required": [
      "ym",
      "sgg",
      "dong_cd",
      "dong_nm",
      "age_band",
      "x",
      "y",
      "crs",
      "coordinate_source",
      "indicators",
      "indicator_version",
      "residents",
      "blind_flag"
    ],
    "title": "Segment",
    "type": "object"
  },
