      "jurisdiction",
      "name",
      "age_min",
      "age_max",
      "eligibility",
      "needs",
      "intensity",
      "delivery",
      "access",
      "isolation_relevance",
      "source_url",
      "collected_at",
      "evidence",
      "catalog_version"
