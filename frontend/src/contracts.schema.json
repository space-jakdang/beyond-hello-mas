      "access": {
        "enum": [
          "application",
          "outreach",
          "both"
        ],
        "title": "Access",
        "type": "string"
      },
      "isolation_relevance": {
        "minLength": 1,
        "title": "Isolation Relevance",
        "type": "string"
      },
      "source_url": {
        "format": "uri",
        "maxLength": 2083,
        "minLength": 1,
        "title": "Source Url",
        "type": "string"
      },
      "collected_at": {
        "format": "date-time",
        "title": "Collected At",
        "type": "string"
      },
      "evidence": {
        "minLength": 1,
        "title": "Evidence",
        "type": "string"
      },
      "catalog_version": {
        "minLength": 1,
        "title": "Catalog Version",
        "type": "string"
