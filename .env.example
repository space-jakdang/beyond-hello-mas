DATA_MODE=sample
LLM_MODE=fake
# Required only when ready to test live mode.
OPENAI_API_KEY=
# Set these only when ready for a live run; verify the selected snapshot and prices.
# OPENAI_MODEL=
LLM_BUDGET_USD=0
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
# PRICE_VERSION=
LLM_MAX_CALLS=4
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Existing private MCP installation (do not put personal paths in committed files).
# MCP_PYTHON=/path/to/beyond-hello-mcp/.venv/bin/python
# MCP_CWD=/path/to/beyond-hello-mcp
MCP_ALLOW_FALLBACK=false

# fixture preserves synthetic resources; curated uses the source-reviewed public catalog.
RESOURCE_CATALOG=fixture

# Separate data.go.kr subscription: 대한민국 공공서비스(혜택) 정보 (15113968).
GOV24_SERVICE_KEY=
POLICY_TIMEOUT_SECONDS=10
POLICY_MAX_PAGES=30
