# Include inside an HTTPS server block with configured certificate and server_name.
# Redirect HTTP to HTTPS separately; do not serve Basic credentials over plaintext.
auth_basic "Private contest review";
auth_basic_user_file /etc/nginx/beyond-hello.htpasswd;
location / {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
}
